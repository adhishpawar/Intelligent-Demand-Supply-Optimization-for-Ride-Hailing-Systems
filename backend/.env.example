# Copy to .env and fill in real values. Never commit the real .env (see
# repo-root .gitignore).

ENVIRONMENT=dev
APP_NAME=RideOps Intelligence

# --- security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# validate_secrets() refuses to boot with the dev default outside dev.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ridehail:ridehail_dev_pw@localhost:5433/rideops_ml

# --- cache / rate limiting --------------------------------------------------
REDIS_URL=redis://localhost:6380/1
INFERENCE_RATE_LIMIT_PER_MINUTE=60

# --- CORS (comma-separated; the frontend's origin) --------------------------
CORS_ORIGINS=http://localhost:5173

# --- server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8100
